# Copie para .env  (Windows: copy .env.example .env) e preencha a chave do OpenRouter.
# O .env NUNCA vai para o Git; este arquivo é só o modelo.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=RAG Example

# LLM que escreve a resposta (o ":free" é a versão gratuita, com limite de uso)
NLP_MODEL=google/gemma-3-27b-it:free

# Embeddings (locais). O "Xenova/..." da aula é a versão ONNX para JavaScript
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Neo4j (Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Score mínimo (0 a 1) para um trecho entrar no contexto.
# Na aula o .env tem 0.9, mas o código ignora e usa 0.5 fixo. Aqui o valor é lido de verdade.
NEO4J_VECTOR_THRESHOLD=0.5
